sequenceDiagram
    actor U as User
    participant FE as React app
    participant AC as AuthController
    participant AS as AuthService
    participant TR as PasswordResetTokenRepository
    participant ES as EmailService
    U->>FE: enter email
    FE->>AC: POST /auth/forgot-password
    AC->>AS: forgotPassword(request)
    AS->>TR: save reset token
    AS->>ES: send reset link email
    AC-->>FE: success message
    U->>FE: open link, enter new password
    FE->>AC: POST /auth/reset-password (token, password)
    AC->>AS: resetPassword(request)
    AS->>TR: find and validate token
    alt token invalid or expired
        AS-->>FE: error
    else valid
        AS->>AS: encode new password and save user
        AS->>TR: delete token
        AC-->>FE: success
    end
